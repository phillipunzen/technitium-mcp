{
  "name": "technitium-mcp",
  "version": "1.0.0",
  "description": "MCP-Server für den Zugriff von Claude auf einen oder mehrere Technitium DNS Server über deren HTTP-API",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "technitium-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js --stdio",
    "dev": "tsc --watch",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "Phillip Unzen",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.2.1",
    "undici": "^7.16.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "typescript": "^5.9.0"
  }
}
