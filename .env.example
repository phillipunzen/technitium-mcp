# ---------------------------------------------------------------------------
# Technitium servers (any number, numbered consecutively)
# Create the API token in the Technitium web console:
#   user menu → Create API Token, or Administration → Sessions → Create Token
# ---------------------------------------------------------------------------
TDNS_1_NAME=dns1
TDNS_1_URL=https://dns1.example.lan:53443
TDNS_1_TOKEN=
# false for self-signed certificates
TDNS_1_VERIFY_TLS=true
# true blocks write tools for this server only (e.g. a cluster secondary)
TDNS_1_READ_ONLY=false

TDNS_2_NAME=dns2
TDNS_2_URL=https://dns2.example.lan:53443
TDNS_2_TOKEN=
TDNS_2_VERIFY_TLS=true
TDNS_2_READ_ONLY=false

# ---------------------------------------------------------------------------
# Protecting the MCP endpoint (at least one of the two is required)
# Generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------
# For clients that can set headers: Authorization: Bearer <MCP_AUTH_TOKEN>
MCP_AUTH_TOKEN=
# For clients without custom headers (claude.ai): https://<host>/mcp/<MCP_PATH_SECRET>
MCP_PATH_SECRET=

# true hides all write tools
MCP_READ_ONLY=false

PORT=8787
# Timeout per Technitium API call in ms
TDNS_TIMEOUT_MS=15000
