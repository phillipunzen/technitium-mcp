# ---------------------------------------------------------------------------
# Technitium-Server (beliebig viele, fortlaufend nummeriert)
# API-Token in der Technitium-Weboberfläche anlegen:
#   Administration → Sessions → "Create Token" (eigenen Benutzer dafür nutzen)
# ---------------------------------------------------------------------------
TDNS_1_NAME=dns1
TDNS_1_URL=https://dns1.example.lan:53443
TDNS_1_TOKEN=
# false bei selbstsigniertem Zertifikat
TDNS_1_VERIFY_TLS=true
# true sperrt schreibende Aktionen nur für diesen Server (z. B. Cluster-Secondary)
TDNS_1_READ_ONLY=false

TDNS_2_NAME=dns2
TDNS_2_URL=https://dns2.example.lan:53443
TDNS_2_TOKEN=
TDNS_2_VERIFY_TLS=true
TDNS_2_READ_ONLY=false

# ---------------------------------------------------------------------------
# Absicherung des MCP-Endpunkts (mindestens eins von beiden ist Pflicht)
# Erzeugen z. B. mit: openssl rand -hex 32
# ---------------------------------------------------------------------------
# Für Claude Code / Clients, die Header setzen können: Authorization: Bearer <MCP_AUTH_TOKEN>
MCP_AUTH_TOKEN=
# Für claude.ai Custom Connector (keine eigenen Header): https://<host>/mcp/<MCP_PATH_SECRET>
MCP_PATH_SECRET=

# true blendet alle schreibenden Tools aus
MCP_READ_ONLY=false

PORT=8787
# Timeout je Technitium-Aufruf in ms
TDNS_TIMEOUT_MS=15000
